{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sweatbox Builder",
  "version": "7.7.0",
  "identifier": "com.flyingfrog.sweatboxbuilder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sweatbox Builder",
        "width": 1440,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxQ0JBM0IyRkQ2QUEzODIKUldTQ28ycjlzcVBMMFNqT2o0OVN5MjZPQ0ZucmJRUDJTbGdqZW5XQlUybWhhNlR3dXZneDU4MlkK",
      "endpoints": [
        "https://github.com/FlyingfrogFR/Sweatbox-Builder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
